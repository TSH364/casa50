# ---------------------------------------------------------------------------
# Fluxo - Financas do Casal
# Copie para .env.local e preencha. NUNCA versione .env.local.
# ---------------------------------------------------------------------------

# URL do projeto Supabase.
# Nuvem:  https://<project-ref>.supabase.co
# Local:  http://127.0.0.1:54321  (valor impresso por `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=

# Chave publicavel (anon). Pode ir para o browser: o isolamento entre casas
# e garantido por Row Level Security no banco, nao por esconder esta chave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de servico. IGNORA RLS - usada apenas em scripts administrativos
# rodados na sua maquina. Nunca referencie esta variavel em codigo que
# possa ir para o cliente e nunca configure na Vercel sem necessidade.
SUPABASE_SERVICE_ROLE_KEY=

# URL publica da aplicacao, usada nos links de confirmacao de e-mail.
# Local: http://localhost:3000   Producao: https://<app>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Leitura de orçamento com IA (OpenRouter) — opcional
#
# Sem a chave, o app continua lendo PDF de orçamento pelo leitor por regra, e
# a opção de ler FOTO não aparece. Com ela, lê PDF, PDF escaneado e foto.
#
# SEGREDO DE VERDADE: paga pelas chamadas. Nunca com prefixo NEXT_PUBLIC_ (iria
# para o navegador) e nunca no .env.production (é versionado). Na Vercel:
# Settings → Environment Variables.
#
# Crie a chave em https://openrouter.ai/settings/keys. Vale pôr um limite de
# gasto nela: uma leitura custa centavos, e o limite protege de um erro que
# repita chamadas.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=

# Modelo usado. Opcional — o padrão é anthropic/claude-sonnet-5. Precisa ler
# imagem. Outro que serve: google/gemini-3.6-flash (mais barato).
# Catálogo: https://openrouter.ai/models
OPENROUTER_MODEL=
